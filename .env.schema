# kriskrug-wp environment contract for agents and local operators.
# Load with Varlock (`varlock load` / `varlock run` / `make varlock-run`).
# Do not use 1Password `op://` references, `op read`, or vault steps.
# Real values belong in the user-managed shared file or repo override below.
# Agents may inspect this schema, but must not read local value files.
#
# Shared profile: import only proven cross-repo names. The project values
# file is imported whole so notion-to-wp can load local env through Varlock
# after the scripts/notion-to-wp/.env symlink is removed on KK's Mac.
# Named .env.kriskrug-wp.local to match WalksWithASwagger/kriskrug-wp.
# @import(~/.agents/env/values/.env.shared.local, pick=[WP_USER, WP_APP_PASSWORD, NOTION_TOKEN, LUMA_API_KEY], allowMissing=true)
# @import(~/.agents/env/values/.env.kriskrug-wp.local, allowMissing=true)
# Working Application Password store for this machine (MCP + REST). Same secret
# as WP_USER/WP_APP_PASSWORD; scripts/common.py accepts either name pair.
# @import(~/.agents/env/wordpress/.env.local, pick=[WP_API_USERNAME, WP_API_PASSWORD], allowMissing=true)
# @defaultRequired=false @defaultSensitive=false
# ---

# WordPress application-password auth for kriskrug.co REST scripts.
# Functionally required for live WP work. Optional here so schema validation
# still succeeds for public and cloud-safe tasks.
# Generate at https://kriskrug.co/wp-admin/profile.php → Application Passwords
# @sensitive @docs(https://kriskrug.co/wp-admin/profile.php)
WP_USER=
# @sensitive
WP_APP_PASSWORD=

# Aliases used by ~/.agents/env/wordpress and mcp-wordpress-remote.sh.
# On KK's laptop these are the ONLY WP credentials with a value source, so in
# practice they are the primary pair, not a fallback. Every repo script accepts
# either pair (scripts/common.py aliases these onto WP_USER/WP_APP_PASSWORD).
# Check with `make doctor` rather than testing WP_USER alone.
# @sensitive @optional
WP_API_USERNAME=
# @sensitive @optional
WP_API_PASSWORD=

# Optional WP overrides (defaults are fine for production ops).
# @optional @example="https://kriskrug.co"
WP_BASE_URL=https://kriskrug.co
# @optional @example="1"
WP_DEFAULT_AUTHOR_ID=1
# @optional @example="login"
WP_AUTH_MODE=

# Notion → WP connector token. Optional for WP-only scripts.
# Keep the name NOTION_TOKEN in this repo (sibling repos may use NOTION_API_KEY).
# @sensitive @optional
NOTION_TOKEN=

# Luma API access for event snapshots and explicitly approved event operations.
# The shared Varlock source is also used by kk-kb; never copy the raw key here.
# @sensitive @optional
LUMA_API_KEY=

# Optional GitHub CLI authentication for Cloud sessions without stored `gh`
# credentials. Branch protection still applies; this is not a bypass token.
# Prefer Cursor Cloud secret name GH_TOKEN (`gh` reads it automatically).
# Never commit the value.
# @sensitive @optional
GH_TOKEN=
# @sensitive @optional
AGENT_GH_PAT=

# Optional path overrides for legacy sibling env and content roots.
# Prefer the shared Varlock imports above. These remain for compatibility.
# @optional
KKAI_ENV_PATH=
# @optional
NOTION_ENV_PATH=
# @optional
KKAI_CONTENT_ROOT=
# @optional
WP_MCP_ENV_FILE=
