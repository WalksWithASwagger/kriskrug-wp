argin: 0;\n  font: 400 clamp(2.2rem, 3.8vw, 4.2rem)/1 var(--serif);\n  letter-spacing: -.045em;\n}\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-inquiries p { max-width: 37ch; }\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-choices { border-top: 1px solid var(--line); }\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page details { border-bottom: 1px solid var(--line); }\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page summary {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 1rem;\n  min-height: 59px;\n  padding: .7rem .2rem;\n  color: var(--forest);\n  font-weight: 750;\n  cursor: pointer;\n  list-style: none;\n}\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page summary::-webkit-details-marker { display: none; }\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page summary::after {\n  flex: none;\n  content: \"+\";\n  font-size: 1.5rem;\n  line-height: 1;\n  font-weight: 400;\n  transition: transform 160ms ease;\n}\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page details[open] summary::after { transform: rotate(45deg); }\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page summary:hover { text-decoration: underline; }\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-choice {\n  padding: 0 .2rem .9rem;\n  font-size: .95rem;\n}\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-choice p { max-width: 62ch; margin: .2rem 0 .55rem; }\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-choice a { color: var(--rust); font-weight: 700; }\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-choice > a { display: inline-flex; min-height: 44px; align-items: center; }\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-context {\n  display: flex;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: .7rem 1rem;\n  padding-block: 1.1rem 2.1rem;\n  border-top: 1px solid var(--line);\n  font-size: .88rem;\n}\nbody.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-context p { margin: 0; }\n@media (max-width: 770px) {\n  body.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-opening { grid-template-columns: minmax(0, 1fr); }\n  body.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-intro { padding-bottom: 2.2rem; }\n  body.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-break { display: none; }\n  body.aurora-theme.page-id-2418 #aurora-main .contact-page .showpiece-title { max-width: 11ch; font-size: clamp(2.75rem, 8.5vw, 4.4rem); }\n  body.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-actions { margin-block: 1.15rem .5rem; }\n  body.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-copy-feedback { bottom: .7rem; }\n  body.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-portrait { min-height: 0; }\n  body.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-portrait img { aspect-ratio: 1.5; object-position: 50% 17%; height: auto; }\n  body.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-portrait figcaption { font-size: .7rem; }\n  body.aurora-theme.page-id-2418 #aurora-main .contact-page .contact-inquiries { grid-template-columns: minmax(0, 1fr); }\n}\n</style>\n<div class=\"contact-page showpiece-page alignfull\">\n<div class=\"wrap contact-opening\">\n<div class=\"contact-intro\">\n<p class=\"eyebrow\">Contact</p>\n<h2 class=\"showpiece-title\">Tell me what<br class=\"contact-break\"/> you’re building.</h2>\n<p class=\"contact-lede\">A talk, a workshop, a collaboration, a strange creative AI project. Tell me who it’s for and what you want to happen.</p>\n<div class=\"contact-actions\">\n<a class=\"button\" href=\"mailto:feelmoreplants@gmail.com\">Email Kris</a>\n<a class=\"button secondary\" href=\"#inquiries\">What to include</a>\n</div>\n<div class=\"contact-address\">\n<a href=\"mailto:feelmoreplants@gmail.com\" id=\"email-address\">feelmoreplants@gmail.com</a>\n<button data-copy-address=\"\" hidden=\"\" type=\"button\">Copy address</button>\n</div>\n<span aria-live=\"polite\" class=\"contact-copy-feedback\" role=\"status\"></span>\n</div>\n<figure class=\"contact-portrait\">\n<img decoding=\"async\" alt=\"Kris Krüg smiles in turquoise glasses and a Vancouver AI shirt, his arms folded\" fetchpriority=\"high\" height=\"1380\" src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/07/kris-krug-van-ai-portrait-2025.jpg?w=920&amp;ssl=1\" width=\"920\"/>\n<figcaption>CreativeMornings Vancouver, October 2025. Photo by Michelle Diamond.</figcaption>\n</figure>\n</div>\n<section aria-labelledby=\"inquiry-heading\" class=\"wrap contact-inquiries\" id=\"inquiries\">\n<div>\n<h2 id=\"inquiry-heading\">Give me the shape of it.</h2>\n<p>A few specifics go a long way. Pick what you have in mind for a starting point.</p>\n</div>\n<div class=\"contact-choices\">\n<details name=\"inquiry\">\n<summary id=\"talk-workshop-inquiry\">Book a talk or workshop</summary>\n<div class=\"contact-choice\">\n<p>Who’s in the room? Send the date, venue or platform, budget range if you have one, and what you want people to walk away with.</p>\n<a href=\"mailto:feelmoreplants@gmail.com?subject=Talk%20or%20workshop&amp;body=Hi%20Kris%2C%0D%0A%0D%0AEvent%20and%20audience%3A%0D%0ADate%20and%20location%3A%0D%0AWhat%20we%20want%20people%20to%20take%20away%3A%0D%0ABudget%20range%20%28if%20known%29%3A\">Start a talk or workshop email</a>\n</div>\n</details>\n<details name=\"inquiry\">\n<summary id=\"strategy-training-inquiry\">Plan strategy or training</summary>\n<div class=\"contact-choice\">\n<p>Tell me what your team is trying, where it’s stuck, and the next decision or skill you want to work on together.</p>\n<a href=\"mailto:feelmoreplants@gmail.com?subject=Strategy%20or%20training&amp;body=Hi%20Kris%2C%0D%0A%0D%0AWhat%20our%20team%20is%20trying%3A%0D%0AWhere%20we%20are%20stuck%3A%0D%0AWhat%20we%20want%20to%20work%20on%3A%0D%0ATiming%3A\">Start a strategy or training email</a>\n</div>\n</details>\n<details name=\"inquiry\">\n<summary>Invite me for media or a podcast</summary>\n<div class=\"contact-choice\">\n<p>Send the topic, audience, format, timing, and a link to the outlet or show. <a href=\"https://kriskrug.co/podcast-guesting-page-epk/\">Get the media kit</a>.</p>\n<a href=\"mailto:feelmoreplants@gmail.com?subject=Media%20or%20podcast%20invitation&amp;body=Hi%20Kris%2C%0D%0A%0D%0AOutlet%20or%20show%3A%0D%0ATopic%20and%20audience%3A%0D%0AFormat%20and%20timing%3A%0D%0APrep%20links%3A\">Start a media or podcast email</a>\n</div>\n</details>\n<details name=\"inquiry\">\n<summary id=\"collaboration-inquiry\">Build something together</summary>\n<div class=\"contact-choice\">\n<p>For a creative project or a community collaboration, tell me who’s involved, what you want to make, and who it could help.</p>\n<a href=\"mailto:feelmoreplants@gmail.com?subject=Creative%20or%20community%20collaboration&amp;body=Hi%20Kris%2C%0D%0A%0D%0AWho%20is%20involved%3A%0D%0AWhat%20we%20want%20to%20make%3A%0D%0AWho%20it%20could%20help%3A%0D%0ATiming%3A\">Start a collaboration email</a>\n</div>\n</details>\n</div>\n</section>\n<aside aria-label=\"More ways to connect\" class=\"wrap contact-context\">\n<p>Want to see what I’ve been making? <a href=\"/about/\">Read my story</a> or <a href=\"/photography/\">explore the photography</a>.</p>\n<p><a href=\"https://vancouver.beehiiv.com/\">Get the newsletter</a> for a monthly letter on AI and creativity.</p>\n</aside>\n</div>\n<script>\nconst copyAddress = document.querySelector('[data-copy-address]');\nconst address = document.getElementById('email-address');\nconst copyFeedback = document.querySelector('.contact-copy-feedback');\n\nif (navigator.clipboard?.writeText) {\n  copyAddress.hidden = false;\n  copyAddress.addEventListener('click', async () => {\n    try {\n      await navigator.clipboard.writeText(address.textContent.trim());\n      copyFeedback.textContent = 'Email address copied.';\n    } catch {\n      copyFeedback.textContent = 'Select the address to copy it.';\n      const range = document.createRange();\n      range.selectNodeContents(address);\n      window.getSelection()?.removeAllRanges();\n      window.getSelection()?.addRange(range);\n    }\n  });\n}\n\nfunction openInquiryFromHash() {\n  const prompt = document.getElementById(window.location.hash.slice(1));\n  if (!prompt?.matches('.contact-choices details > summary')) return;\n\n  prompt.parentElement.open = true;\n  prompt.focus({ preventScroll: true });\n}\n\nopenInquiryFromHash();\nwindow.addEventListener('hashchange', openInquiryFromHash);\nwindow.addEventListener('pageshow', openInquiryFromHash);\n</script>\n\n",
