  "modified": "2026-07-24T22:21:48",
  "content_raw": "<!-- wp:html -->\n<!-- content-architecture-2026:contact -->\n<style>\n.kk-contact {\n  --kk-ink: #f0f0f5;\n  --kk-ink-2: #fff;\n  --kk-muted: #a6a6b3;\n  --kk-line: rgba(255, 255, 255, 0.14);\n  --kk-card: rgba(255, 255, 255, 0.04);\n  --kk-paper: rgba(255, 255, 255, 0.05);\n  --kk-accent: #00e5ff;\n  --kk-hot: #ff6a6a;\n  --kk-r: 14px;\n  --kk-sh: 0 1px 2px rgba(0, 0, 0, 0.45), 0 12px 28px -14px rgba(0, 0, 0, 0.7);\n  color: var(--kk-ink);\n  max-width: 72rem;\n}\n.kk-contact p,\n.kk-contact p::first-letter,\n.kk-contact li {\n  background: transparent !important;\n  background-color: transparent !important;\n  box-shadow: none !important;\n}\n.kk-contact p::first-letter {\n  initial-letter: normal !important;\n  font-size: inherit !important;\n  font-weight: inherit !important;\n  float: none !important;\n  margin: 0 !important;\n  line-height: inherit !important;\n  color: inherit !important;\n}\n.kk-contact a {\n  color: var(--kk-accent);\n  font-weight: 700;\n  text-decoration: none;\n}\n.kk-contact a:hover {\n  text-decoration: underline;\n  text-underline-offset: 3px;\n}\n.kk-contact-hero {\n  padding: 0.2rem 0 1.8rem;\n  border-bottom: 1px solid var(--kk-line);\n}\n.kk-contact-kicker {\n  margin: 0 0 0.6rem;\n  text-transform: uppercase;\n  letter-spacing: 0.14em;\n  font-size: 0.74rem;\n  color: var(--kk-hot);\n  font-weight: 800;\n}\n.kk-contact-display {\n  margin: 0.1rem 0 0.8rem;\n  font-size: clamp(1.85rem, 3.4vw, 2.55rem);\n  line-height: 1.08;\n  letter-spacing: -0.02em;\n  font-weight: 800;\n  max-width: 38rem;\n  color: var(--kk-ink-2);\n}\n.kk-contact-lead {\n  font-size: 1.12rem;\n  line-height: 1.62;\n  max-width: 42rem;\n  color: var(--kk-ink);\n  margin: 0 0 1rem;\n}\n.kk-contact-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.6rem;\n  margin: 1.35rem 0 0;\n}\n.kk-contact-button {\n  display: inline-block;\n  padding: 0.7rem 1.1rem;\n  border: 2px solid var(--kk-accent);\n  border-radius: 8px;\n  text-decoration: none !important;\n  background: var(--kk-accent);\n  color: #04121a !important;\n  font-weight: 700;\n  transition: transform 0.15s ease, box-shadow 0.15s ease;\n}\n.kk-contact-button:hover {\n  transform: translateY(-2px);\n  box-shadow: var(--kk-sh);\n  text-decoration: none !important;\n}\n.kk-contact-button.secondary {\n  background: transparent;\n  color: var(--kk-ink) !important;\n  border-color: var(--kk-line);\n}\n.kk-contact-button.secondary:hover {\n  border-color: var(--kk-accent);\n  color: var(--kk-accent) !important;\n}\n.kk-contact-hero-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.05fr) minmax(260px, 0.9fr);\n  gap: 1.5rem;\n  align-items: center;\n}\n.kk-contact-hero-photo {\n  margin: 0;\n  border: 1px solid var(--kk-line);\n  border-radius: var(--kk-r);\n  overflow: hidden;\n  background: var(--kk-card);\n  box-shadow: var(--kk-sh);\n}\n.kk-contact-hero-photo img {\n  display: block;\n  width: 100%;\n  aspect-ratio: 4 / 5;\n  object-fit: cover;\n  object-position: center top;\n}\n.kk-contact-hero-photo figcaption {\n  margin: 0;\n  padding: 0.7rem 0.9rem;\n  font-size: 0.78rem;\n  color: var(--kk-muted);\n  border-top: 1px solid var(--kk-line);\n  background: rgba(0, 0, 0, 0.28);\n}\n.kk-contact-section {\n  padding: 2.4rem 0;\n  border-bottom: 1px solid var(--kk-line);\n}\n.kk-contact-section > h2 {\n  position: relative;\n  padding-top: 1.1rem;\n  margin: 0 0 1rem;\n  font-size: 1.55rem;\n  line-height: 1.14;\n  letter-spacing: -0.015em;\n  font-weight: 800;\n  color: var(--kk-ink-2);\n}\n.kk-contact-section > h2::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 2.4rem;\n  height: 4px;\n  border-radius: 3px;\n  background: var(--kk-hot);\n}\n.kk-contact-section-intro {\n  max-width: 48rem;\n  margin: 0 0 1.2rem;\n  color: var(--kk-muted);\n  line-height: 1.6;\n}\n.kk-contact-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 1rem;\n}\n.kk-contact-card {\n  border: 1px solid var(--kk-line);\n  border-radius: var(--kk-r);\n  background: var(--kk-card);\n  padding: 1.1rem;\n  box-shadow: var(--kk-sh);\n}\n.kk-contact-card h3 {\n  margin: 0 0 0.45rem;\n  font-size: 1.08rem;\n  color: var(--kk-ink-2);\n}\n.kk-contact-card p {\n  margin: 0;\n  color: var(--kk-muted);\n  line-height: 1.5;\n}\n.kk-contact-two {\n  display: grid;\n  grid-template-columns: minmax(0, 1.1fr) minmax(240px, 0.9fr);\n  gap: 1.2rem;\n  align-items: stretch;\n}\n.kk-contact-panel {\n  border: 1px solid var(--kk-line);\n  border-radius: var(--kk-r);\n  background: var(--kk-paper);\n  padding: 1.25rem;\n}\n.kk-contact-panel h2,\n.kk-contact-panel h3 {\n  margin: 0 0 0.55rem;\n  color: var(--kk-ink-2);\n}\n.kk-contact-panel p {\n  margin: 0 0 0.85rem;\n  color: var(--kk-muted);\n  line-height: 1.55;\n}\n.kk-contact-panel p:last-child {\n  margin-bottom: 0;\n}\n.kk-contact-email {\n  font-size: 1.15rem;\n  font-weight: 700;\n  color: var(--kk-ink-2) !important;\n  word-break: break-word;\n}\n@media (max-width: 760px) {\n  .kk-contact-hero-grid,\n  .kk-contact-two {\n    grid-template-columns: 1fr;\n  }\n  .kk-contact-actions {\n    display: grid;\n  }\n}\n</style>\n\n<div class=\"kk-contact\">\n  <section class=\"kk-contact-hero\">\n    <div class=\"kk-contact-hero-grid\">\n      <div>\n        <p class=\"kk-contact-kicker\">Contact</p>\n        <h2 class=\"kk-contact-display\">Tell me what kind of room you are building.</h2>\n        <p class=\"kk-contact-lead\">The fastest path is email. Send the shape of the thing: keynote, workshop, media appearance, strategy session, community partnership, or strange creative AI project.</p>\n        <p class=\"kk-contact-lead\">I read for context first. Include who it is for, when it needs to happen, where it happens, and what would make the work genuinely useful.</p>\n        <div class=\"kk-contact-actions\">\n          <a class=\"kk-contact-button\" href=\"mailto:feelmoreplants@gmail.com?subject=Inquiry%20from%20kriskrug.co\">Email Kris</a>\n          <a class=\"kk-contact-button secondary\" href=\"https://kriskrug.beehiiv.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Get the newsletter</a>\n        </div>\n      </div>\n      <figure class=\"kk-contact-hero-photo\">\n        <img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/07/kris-krug-creativemornings-portrait-close-2026-scaled.jpg?w=1200&amp;ssl=1\"\n          alt=\"Portrait of Kris Kr\u00fcg in a white shirt beside a brightly painted staircase\"\n          width=\"1200\"\n          height=\"1500\"\n          loading=\"eager\"\n        />\n        <figcaption>CreativeMornings Vancouver, May 1, 2026. Photo: Michelle Diamond.</figcaption>\n      </figure>\n    </div>\n  </section>\n\n  <section class=\"kk-contact-section\">\n    <h2>What to include</h2>\n    <p class=\"kk-contact-section-intro\">A short brief beats a vague hello. These are the details that help me answer faster.</p>\n    <div class=\"kk-contact-grid\">\n      <article class=\"kk-contact-card\">\n        <h3>Book a talk or workshop</h3>\n        <p>Share the audience, date, venue or platform, budget range if you have one, and the change you want in the room.</p>\n      </article>\n      <article class=\"kk-contact-card\">\n        <h3>Plan strategy or training</h3>\n        <p>Tell me what your team is trying to do with AI, what is stuck, and what kind of support would make the next step safer.</p>\n      </article>\n      <article class=\"kk-contact-card\">\n        <h3>Media and podcasts</h3>\n        <p>Send the topic, format, timing, audience, and any prep links. The <a href=\"/podcast-guesting-page-epk/\">media EPK</a> has a cleaner producer-facing version.</p>\n      </article>\n      <article class=\"kk-contact-card\">\n        <h3>Community collaborations</h3>\n        <p>For BC + AI, Vancouver AI, AI Film Club, or ecosystem work, include the people involved and the public value you want to create.</p>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"kk-contact-section\" style=\"border-bottom:0;\">\n    <div class=\"kk-contact-two\">\n      <div class=\"kk-contact-panel\">\n        <h2>Email Kris</h2>\n        <p><a class=\"kk-contact-email\" href=\"mailto:feelmoreplants@gmail.com\">feelmoreplants@gmail.com</a></p>\n        <p>Same address for keynotes, workshops, media, strategy, and community partnerships.</p>\n        <p><a class=\"kk-contact-button\" href=\"mailto:feelmoreplants@gmail.com?subject=Inquiry%20from%20kriskrug.co\">Send the note</a></p>\n      </div>\n      <div class=\"kk-contact-panel\">\n        <h3>Newsletter</h3>\n        <p>AI and creativity, once a week, no hype. Named people, real work, no vaporware. Free.</p>\n        <p><a class=\"kk-contact-button secondary\" href=\"https://kriskrug.beehiiv.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Subscribe free</a></p>\n      </div>\n    </div>\n  </section>\n</div>\n<!-- /wp:html -->\n"
}