  "content_raw": "<!-- wp:html -->\n<style>\n.kk-sponsor {\n  --kk-ink: #f0f0f5;\n  --kk-ink-2: #fff;\n  --kk-muted: #a6a6b3;\n  --kk-line: rgba(255, 255, 255, 0.14);\n  --kk-card: rgba(255, 255, 255, 0.04);\n  --kk-paper: rgba(255, 255, 255, 0.05);\n  --kk-accent: #00e5ff;\n  --kk-hot: #ff6a6a;\n  --kk-r: 14px;\n  --kk-sh: 0 1px 2px rgba(0, 0, 0, 0.45), 0 12px 28px -14px rgba(0, 0, 0, 0.7);\n  color: var(--kk-ink);\n  max-width: 72rem;\n}\n.kk-sponsor p,\n.kk-sponsor p::first-letter,\n.kk-sponsor li {\n  background: transparent !important;\n  background-color: transparent !important;\n  box-shadow: none !important;\n}\n.kk-sponsor p::first-letter {\n  initial-letter: normal !important;\n  font-size: inherit !important;\n  font-weight: inherit !important;\n  float: none !important;\n  margin: 0 !important;\n  line-height: inherit !important;\n  color: inherit !important;\n}\n.kk-sponsor a {\n  color: var(--kk-accent);\n  font-weight: 700;\n  text-decoration: none;\n}\n.kk-sponsor a:hover {\n  text-decoration: underline;\n  text-underline-offset: 3px;\n}\n\n/* Theme page header duplicates the deck; remove the empty bar on this page only. */\nbody.page-id-12625 .aurora-page-header {\n  display: none !important;\n}\n\n.kk-sponsor-hero {\n  padding: 0.2rem 0 1.8rem;\n  border-bottom: 1px solid var(--kk-line);\n}\n.kk-sponsor-kicker {\n  margin: 0 0 0.6rem;\n  text-transform: uppercase;\n  letter-spacing: 0.14em;\n  font-size: 0.74rem;\n  color: var(--kk-hot);\n  font-weight: 800;\n}\n.kk-sponsor-display {\n  margin: 0.1rem 0 0.8rem;\n  font-size: clamp(1.85rem, 3.4vw, 2.55rem);\n  line-height: 1.08;\n  letter-spacing: -0.02em;\n  font-weight: 800;\n  max-width: 40rem;\n  color: var(--kk-ink-2);\n}\n.kk-sponsor-lead {\n  font-size: 1.12rem;\n  line-height: 1.62;\n  max-width: 42rem;\n  color: var(--kk-ink);\n  margin: 0 0 1rem;\n  background: transparent !important;\n}\n.kk-sponsor-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.6rem;\n  margin: 1.35rem 0 0;\n}\n.kk-sponsor-button {\n  display: inline-block;\n  padding: 0.7rem 1.1rem;\n  border: 2px solid var(--kk-accent);\n  border-radius: 8px;\n  text-decoration: none !important;\n  background: var(--kk-accent);\n  color: #04121a !important;\n  font-weight: 700;\n  transition: transform 0.15s ease, box-shadow 0.15s ease;\n}\n.kk-sponsor-button:hover {\n  transform: translateY(-2px);\n  box-shadow: var(--kk-sh);\n  text-decoration: none !important;\n}\n.kk-sponsor-button.secondary {\n  background: transparent;\n  color: var(--kk-ink) !important;\n  border-color: var(--kk-line);\n}\n.kk-sponsor-button.secondary:hover {\n  border-color: var(--kk-accent);\n  color: var(--kk-accent) !important;\n}\n.kk-sponsor-hero-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);\n  gap: 1.5rem;\n  align-items: center;\n}\n.kk-sponsor-hero-photo {\n  margin: 0;\n  border: 1px solid var(--kk-line);\n  border-radius: var(--kk-r);\n  overflow: hidden;\n  background: var(--kk-card);\n  box-shadow: var(--kk-sh);\n}\n.kk-sponsor-hero-photo img {\n  display: block;\n  width: 100%;\n  aspect-ratio: 4 / 3;\n  object-fit: cover;\n}\n.kk-sponsor-hero-photo figcaption {\n  margin: 0;\n  padding: 0.7rem 0.9rem;\n  font-size: 0.78rem;\n  color: var(--kk-muted);\n  border-top: 1px solid var(--kk-line);\n  background: rgba(0, 0, 0, 0.28);\n}\n.kk-sponsor-proof {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));\n  gap: 0.7rem;\n  margin-top: 1.2rem;\n}\n.kk-sponsor-proof div {\n  border: 1px solid var(--kk-line);\n  border-top: 3px solid var(--kk-accent);\n  border-radius: 10px;\n  padding: 0.95rem 1rem;\n  background: var(--kk-card);\n}\n.kk-sponsor-proof strong {\n  display: block;\n  font-size: 1.25rem;\n  line-height: 1.15;\n  color: var(--kk-ink-2);\n}\n.kk-sponsor-proof span {\n  display: block;\n  color: var(--kk-muted);\n  margin-top: 0.25rem;\n  font-size: 0.92rem;\n  line-height: 1.4;\n}\n\n.kk-sponsor-section {\n  padding: 2.4rem 0;\n  border-bottom: 1px solid var(--kk-line);\n}\n.kk-sponsor-section > h2 {\n  position: relative;\n  padding-top: 1.1rem;\n  margin: 0 0 1rem;\n  font-size: 1.55rem;\n  line-height: 1.14;\n  letter-spacing: -0.015em;\n  font-weight: 800;\n  color: var(--kk-ink-2);\n}\n.kk-sponsor-section > h2::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 2.4rem;\n  height: 4px;\n  border-radius: 3px;\n  background: var(--kk-hot);\n}\n.kk-sponsor-section-intro {\n  max-width: 48rem;\n  margin: 0 0 1.2rem;\n  color: var(--kk-muted);\n  line-height: 1.6;\n  background: transparent !important;\n}\n\n.kk-sponsor-strip {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0.85rem;\n}\n.kk-sponsor-strip figure {\n  margin: 0;\n  border: 1px solid var(--kk-line);\n  border-radius: var(--kk-r);\n  overflow: hidden;\n  background: var(--kk-card);\n  box-shadow: var(--kk-sh);\n}\n.kk-sponsor-strip img {\n  display: block;\n  width: 100%;\n  aspect-ratio: 16 / 10;\n  object-fit: cover;\n}\n.kk-sponsor-strip figcaption {\n  padding: 0.75rem 0.9rem;\n  font-size: 0.82rem;\n  color: var(--kk-muted);\n  line-height: 1.4;\n}\n\n.kk-sponsor-two {\n  display: grid;\n  grid-template-columns: minmax(0, 1.15fr) minmax(240px, 0.85fr);\n  gap: 1.4rem;\n  align-items: start;\n}\n.kk-sponsor-two ul {\n  margin: 0.6rem 0 0 1.1rem;\n  color: var(--kk-muted);\n}\n.kk-sponsor-two li {\n  margin: 0.35rem 0;\n}\n.kk-sponsor-callout {\n  background: var(--kk-paper);\n  border: 1px solid var(--kk-line);\n  border-radius: var(--kk-r);\n  padding: 1.2rem;\n}\n.kk-sponsor-callout h3 {\n  margin: 0 0 0.55rem;\n  color: var(--kk-ink-2);\n  font-size: 1.05rem;\n}\n.kk-sponsor-callout p {\n  margin: 0;\n  color: var(--kk-muted);\n  line-height: 1.55;\n  background: transparent !important;\n}\n\n.kk-sponsor-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));\n  gap: 1.1rem;\n}\n.kk-sponsor-card {\n  border: 1px solid var(--kk-line);\n  border-radius: var(--kk-r);\n  background: var(--kk-card);\n  overflow: hidden;\n  box-shadow: var(--kk-sh);\n  transition: transform 0.18s ease, border-color 0.18s ease;\n}\n.kk-sponsor-card:hover {\n  transform: translateY(-3px);\n  border-color: rgba(0, 229, 255, 0.4);\n}\n.kk-sponsor-card img {\n  display: block;\n  width: 100%;\n  aspect-ratio: 16 / 9;\n  object-fit: cover;\n}\n.kk-sponsor-card-body {\n  padding: 1.1rem;\n}\n.kk-sponsor-tag {\n  display: inline-block;\n  margin: 0 0 0.55rem;\n  background: rgba(255, 106, 106, 0.16);\n  color: var(--kk-hot);\n  padding: 0.28rem 0.6rem;\n  border-radius: 999px;\n  font-size: 0.66rem;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n.kk-sponsor-card h3 {\n  margin: 0 0 0.4rem;\n  font-size: 1.15rem;\n  color: var(--kk-ink-2);\n}\n.kk-sponsor-price {\n  margin: 0 0 0.65rem;\n  color: var(--kk-accent);\n  font-weight: 800;\n  font-size: 1.2rem;\n}\n.kk-sponsor-card p {\n  margin: 0.4rem 0;\n  color: var(--kk-muted);\n  background: transparent !important;\n}\n.kk-sponsor-card ul {\n  margin: 0.6rem 0 0 1.05rem;\n  color: var(--kk-muted);\n}\n.kk-sponsor-card li {\n  margin: 0.28rem 0;\n}\n\n.kk-sponsor-addons {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 0.85rem;\n}\n.kk-sponsor-addon {\n  border: 1px solid var(--kk-line);\n  border-radius: var(--kk-r);\n  padding: 1.1rem;\n  background: var(--kk-card);\n}\n.kk-sponsor-addon h3 {\n  margin: 0 0 0.45rem;\n  font-size: 1.05rem;\n  color: var(--kk-ink-2);\n}\n.kk-sponsor-addon p {\n  margin: 0;\n  color: var(--kk-muted);\n  background: transparent !important;\n}\n\n.kk-sponsor-cta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.6rem;\n  margin-top: 1.1rem;\n}\n\n@media (max-width: 760px) {\n  .kk-sponsor-hero-grid,\n  .kk-sponsor-two,\n  .kk-sponsor-strip {\n    grid-template-columns: 1fr;\n  }\n  .kk-sponsor-actions {\n    display: grid;\n  }\n}\n</style>\n\n<div class=\"kk-sponsor\">\n  <section class=\"kk-sponsor-hero\">\n    <div class=\"kk-sponsor-hero-grid\">\n      <div>\n        <p class=\"kk-sponsor-kicker\">Sponsorship &amp; partnership</p>\n        <h2 class=\"kk-sponsor-display\">Put your brand in rooms where AI, culture, and community actually meet.</h2>\n        <p class=\"kk-sponsor-lead\">I build and host high-trust rooms across talks, community, and media. Sponsorship here is not banner inventory \u2014 it is placement beside work people already show up for.</p>\n        <p class=\"kk-sponsor-lead\">Built for partners who want awareness with credibility: founders, operators, creative teams, and the public rooms that shape how AI lands in BC and beyond.</p>\n        <div class=\"kk-sponsor-actions\">\n          <a class=\"kk-sponsor-button\" href=\"mailto:feelmoreplants@gmail.com\">Start a conversation</a>\n          <a class=\"kk-sponsor-button secondary\" href=\"/events/\">See upcoming rooms</a>\n          <a class=\"kk-sponsor-button secondary\" href=\"/podcast-guesting-page-epk/\">Media EPK</a>\n        </div>\n      </div>\n      <figure class=\"kk-sponsor-hero-photo\">\n        <img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/05/kk-laSalle-both-hands-full-25-scaled.jpg?w=1400&amp;ssl=1\" alt=\"Kris Krug speaking on stage about creativity and AI\" loading=\"eager\" />\n        <figcaption>LaSalle College Vancouver \u2014 Both Hands Full keynote room.</figcaption>\n      </figure>\n    </div>\n    <div class=\"kk-sponsor-proof\" aria-label=\"Audience and partnership signals\">\n      <div><strong>5.4k+</strong><span>Community members and active listeners across Discord and related rooms.</span></div>\n      <div><strong>32%</strong><span>Average engagement on sponsor-led moments.</span></div>\n      <div><strong>Stage + media</strong><span>Keynotes, meetups, podcasts, and newsletter distribution in one lane.</span></div>\n      <div><strong>Operator networks</strong><span>Startup, AI, and creative communities that already pay attention.</span></div>\n    </div>\n  </section>\n\n  <section class=\"kk-sponsor-section\">\n    <h2>The rooms you buy into</h2>\n    <p class=\"kk-sponsor-section-intro\">Proof before packages. These are the kinds of rooms sponsorship sits inside \u2014 stage, community, and public learning \u2014 not stock graphics.</p>\n    <div class=\"kk-sponsor-strip\">\n      <figure>\n        <img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2024/09/AI_Meetup_August2024_MichelleDiamond-184-scaled.jpg?w=1200&amp;ssl=1\" alt=\"Kris Krug speaking at a Vancouver AI community event\" loading=\"lazy\" />\n        <figcaption>Vancouver AI community meetup \u2014 live audience, microphone, room energy.</figcaption>\n      </figure>\n      <figure>\n        <img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/05/kk-laSalle-both-hands-full-10-scaled.jpg?w=1200&amp;ssl=1\" alt=\"Kris Krug presenting an AI keynote at LaSalle College Vancouver\" loading=\"lazy\" />\n        <figcaption>Keynote stage \u2014 projected slides, paced talk, institutional room.</figcaption>\n      </figure>\n      <figure>\n        <img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2024/09/AI_Meetup_August2024_MichelleDiamond-195-scaled.jpg?w=1200&amp;ssl=1\" alt=\"Kris Krug hosting a Vancouver AI Community Meetup\" loading=\"lazy\" />\n        <figcaption>Hosting and facilitation \u2014 brand adjacency beside trusted community ritual.</figcaption>\n      </figure>\n    </div>\n  </section>\n\n  <section class=\"kk-sponsor-section\">\n    <h2>Why partner here</h2>\n    <div class=\"kk-sponsor-two\">\n      <div>\n        <p class=\"kk-sponsor-section-intro\" style=\"margin-bottom:0.7rem;\">This is integrated storytelling at the intersection of product, AI strategy, community action, and startup reality. Your brand shows up where attention is already earned.</p>\n        <ul>\n          <li>High-intent audience across founder, operator, and maker mindsets.</li>\n          <li>Trust-led messaging from long-form interviews, keynotes, and member touchpoints.</li>\n          <li>Placement designed for recall \u2014 not just impressions.</li>\n          <li>Flexible formats: segments, co-hosted sessions, community activations.</li>\n        </ul>\n      </div>\n      <aside class=\"kk-sponsor-callout\">\n        <h3>What we optimize for</h3>\n        <p>Attention, credibility, and a clear next step \u2014 without sanding off the human tone that makes the rooms work.</p>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"kk-sponsor-section\">\n    <h2>Sponsorship packages</h2>\n    <p class=\"kk-sponsor-section-intro\">Three clear starting points. Custom mixes are normal once we know the announcement, hiring push, or community goal.</p>\n    <div class=\"kk-sponsor-grid\">\n      <article class=\"kk-sponsor-card\">\n        <img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/05/kk-cmvan-keynote-header.png?w=1200&amp;ssl=1\" alt=\"Punk Rock AI CreativeMornings Vancouver keynote artwork\" loading=\"lazy\" />\n        <div class=\"kk-sponsor-card-body\">\n          <span class=\"kk-sponsor-tag\">Starter</span>\n          <p class=\"kk-sponsor-price\">$2,500</p>\n          <h3>Launch Partner</h3>\n          <p>One-shot campaign for a fast brand test.</p>\n          <ul>\n            <li>One premium content placement</li>\n            <li>Social post + deck linkout</li>\n            <li>Post-campaign summary</li>\n          </ul>\n        </div>\n      </article>\n      <article class=\"kk-sponsor-card\">\n        <img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2024/09/AI_Meetup_August2024_MichelleDiamond-184-scaled.jpg?w=1200&amp;ssl=1\" alt=\"Audience at a Vancouver AI community meetup\" loading=\"lazy\" />\n        <div class=\"kk-sponsor-card-body\">\n          <span class=\"kk-sponsor-tag\">Growth</span>\n          <p class=\"kk-sponsor-price\">$7,500</p>\n          <h3>Momentum Partner</h3>\n          <p>Sustained visibility across one season.</p>\n          <ul>\n            <li>2 podcast episodes + 1 event mention</li>\n            <li>Audience asset or giveaway integration</li>\n            <li>Dedicated campaign page in deck format</li>\n          </ul>\n        </div>\n      </article>\n      <article class=\"kk-sponsor-card\">\n        <img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/05/kk-laSalle-both-hands-full-25-scaled.jpg?w=1200&amp;ssl=1\" alt=\"Full keynote stage with Kris Krug presenting\" loading=\"lazy\" />\n        <div class=\"kk-sponsor-card-body\">\n          <span class=\"kk-sponsor-tag\">Command</span>\n          <p class=\"kk-sponsor-price\">$15,000</p>\n          <h3>Flagship Partner</h3>\n          <p>Full-funnel positioning around a major announcement.</p>\n          <ul>\n            <li>3 integrated moments across content channels</li>\n            <li>Conference segment co-branded</li>\n            <li>Joint report, interview, or announcement asset</li>\n          </ul>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"kk-sponsor-section\">\n    <h2>Add-ons</h2>\n    <p class=\"kk-sponsor-section-intro\">Need a live demo slot, hiring placement, or custom audience brief? We can build it.</p>\n    <div class=\"kk-sponsor-addons\">\n      <div class=\"kk-sponsor-addon\">\n        <h3>Creator collab</h3>\n        <p>Product demos, interviews, and operator deep dives in my own tone.</p>\n      </div>\n      <div class=\"kk-sponsor-addon\">\n        <h3>Event integration</h3>\n        <p>Badge logo, stage mention, room naming, and activation support.</p>\n      </div>\n      <div class=\"kk-sponsor-addon\">\n        <h3>Lead gen loop</h3>\n        <p>Landing page with tracking, newsletter mention, and retargeting hooks.</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"kk-sponsor-section\" style=\"border-bottom:0;\">\n    <h2>Let\u2019s move this fast</h2>\n    <p class=\"kk-sponsor-section-intro\">Tell me the outcome you need \u2014 awareness, hiring, product launch, or community presence \u2014 and we will map the room.</p>\n    <div class=\"kk-sponsor-cta\">\n      <a class=\"kk-sponsor-button\" href=\"mailto:feelmoreplants@gmail.com\">Email feelmoreplants@gmail.com</a>\n      <a class=\"kk-sponsor-button secondary\" href=\"/events/\">Upcoming talks &amp; events</a>\n      <a class=\"kk-sponsor-button secondary\" href=\"/generative-ai-services/\">Work with me</a>\n    </div>\n  </section>\n</div>\n<!-- /wp:html -->\n"
}