roject-groups {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 24px clamp(30px, 5vw, 72px);\n}\n.work-editorial .work-project-groups h3 {\n  margin-block: 0 .45rem;\n  font: 700 .85rem/1.4 var(--work-sans);\n  letter-spacing: .08em;\n  text-transform: uppercase;\n}\n.work-editorial .work-projects {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n.work-editorial .work-projects li {\n  margin: 0;\n  padding: 0;\n  border-block-start: 1px solid var(--work-line);\n}\n.work-editorial .work-projects a {\n  display: grid;\n  gap: 2px;\n  padding: 12px 3px;\n  min-height: 44px;\n  text-decoration: none;\n}\n.work-editorial .work-projects strong {\n  font-size: 1.05rem;\n  font-weight: 700;\n  text-decoration: underline;\n  text-underline-offset: .21em;\n}\n.work-editorial .work-projects a:hover strong {\n  text-underline-offset: .35em;\n}\n.work-editorial .work-projects span {\n  color: var(--work-muted);\n  line-height: 1.42;\n}\n.work-editorial .work-next {\n  padding-block: clamp(32px, 5vw, 64px);\n}\n.work-editorial .work-next p {\n  margin-block: .7rem 0;\n  max-width: 60ch;\n}\n.work-editorial .work-paths {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0 20px;\n  margin-block: 12px 0;\n}\n@media (max-width: 720px) {\n  .work-editorial .work-feature,\n  .work-editorial .work-studies,\n  .work-editorial .work-index-header,\n  .work-editorial .work-project-groups {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .work-editorial .work-opening h2 {\n    font-size: clamp(2.85rem, 12vw, 4.8rem);\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .work-editorial a {\n    transition: none;\n  }\n}\n</style>\n<div class=\"work-editorial alignfull\">\n  <section class=\"work-opening\" aria-labelledby=\"work-futureproof\">\n    <article class=\"work-wrap work-feature\">\n      <div>\n        <p class=\"work-kicker\">Selected work · Festival and public archive</p>\n        <h2 id=\"work-futureproof\">Futureproof Festival of AI</h2>\n        <p class=\"work-lead\">I founded Futureproof to bring artists, builders and skeptics into one room. I directed three days at Vancouver’s Space Centre and wrote the public proceedings.</p>\n        <div class=\"work-feature-links\">\n          <a class=\"work-button\" href=\"https://www.futureproof.website/2026/proceedings/\">Read the proceedings</a>\n          <a href=\"#project-index\">Browse all projects</a>\n        </div>\n      </div>\n      <figure>\n        <img data-recalc-dims=\"1\" src=\"https://i0.wp.com/bc-ai.ca/images/futureproof/day-three/FPD3-576.webp?resize=1800%2C1200&#038;ssl=1\" width=\"1800\" height=\"1200\" alt=\"The festival crew gathers onstage beneath a projected thank-you message.\" fetchpriority=\"high\" decoding=\"async\"/>\n        <figcaption>Futureproof closing night, October 30, 2026. Photo by Michelle Diamond / Diamond’s Edge Photography. <a href=\"https://bc-ai.ca/news/the-robots-in-the-lobby\">Festival recap</a></figcaption>\n      </figure>\n    </article>\n  </section>\n\n  <section class=\"work-wrap work-studies\" aria-label=\"More case studies\">\n    <article class=\"work-study\" aria-labelledby=\"work-meetup\">\n      <figure>\n        <img data-recalc-dims=\"1\" src=\"https://i0.wp.com/www.futureproof.website/photos/community/futureproof-photo-library/web/fph-087-nov2025-bcai-michellediamond-171.webp?resize=1800%2C1200&#038;ssl=1\" width=\"1800\" height=\"1200\" alt=\"People watch a panel from the seats of the Space Centre auditorium.\" loading=\"lazy\" decoding=\"async\"/>\n        <figcaption>Vancouver AI Meetup, November 2025. Photo by Michelle Diamond. <a href=\"https://www.futureproof.website/press/assets/\">Image source</a></figcaption>\n      </figure>\n      <p class=\"work-kicker\">Community · Monthly since 2024</p>\n      <h2 id=\"work-meetup\">Vancouver AI Meetup</h2>\n      <p>I started a monthly gathering in my studio for people who wanted to show their work and talk about what AI was doing to it. I still host and curate the program. The public archive keeps the talks, recordings and photo recaps reachable after the room empties.</p>\n      <div class=\"work-case-links\">\n        <a href=\"https://bc-ai.ca/events/series/vancouver-ai-meetup\">Explore the meetup archive</a>\n        <a href=\"https://bc-ai.ca/news/vancouver-ai-meetup-32-data-for-good-taleeb-noormohamed-recap\">Read a night’s recap</a>\n      </div>\n    </article>\n\n    <article class=\"work-study work-study-storm\" aria-labelledby=\"work-storm\">\n      <figure>\n        <img data-recalc-dims=\"1\" src=\"https://i0.wp.com/lightningstrike.org/__l5e/assets-v1/a6927ff4-8d22-4103-a21e-5a136ae28ef0/the-sky-smoked-back-social-v1.jpg?resize=1200%2C630&#038;ssl=1\" width=\"1200\" height=\"630\" alt=\"The Sky Smoked Back title over purple lightning above a Vancouver porch.\" loading=\"lazy\" decoding=\"async\"/>\n        <figcaption>Key art from The Sky Smoked Back.</figcaption>\n      </figure>\n      <p class=\"work-kicker\">Film · Interactive web</p>\n      <h2 id=\"work-storm\">The Sky Smoked Back</h2>\n      <p>I made a 56-second film with Suzy Easton about one rare Vancouver lightning night. The site pairs it with a storm you can run in your browser and a map for people to share their own memories of that night.</p>\n      <div class=\"work-case-links\">\n        <a href=\"https://lightningstrike.org/\">Watch the film and explore the map</a>\n      </div>\n    </article>\n  </section>\n\n  <section id=\"project-index\" class=\"work-index\" aria-labelledby=\"work-projects-title\" tabindex=\"-1\">\n    <div class=\"work-wrap\">\n      <div class=\"work-index-header\">\n        <h2 id=\"work-projects-title\">Project index</h2>\n        <p>Systems, rooms, stories, and strange machines. The rest of the work, from community infrastructure to small corners of the internet.</p>\n      </div>\n      <div class=\"work-project-groups\">\n        <div>\n          <h3>Community and practice</h3>\n          <ul class=\"work-projects\">\n            <li><a href=\"https://bc-ai.ca/\"><strong>BC + AI Ecosystem</strong><span>Community infrastructure for responsible AI in British Columbia.</span></a></li>\n            <li><a href=\"/responsible-ai-professional/\"><strong>Responsible AI Professional</strong><span>Practical ethics training for teams shipping real systems.</span></a></li>\n            <li><a href=\"/speaking/\"><strong>AI keynotes</strong><span>Talks and workshops about creativity, taste and responsibility.</span></a></li>\n            <li><a href=\"https://indigenomics.ai/\"><strong>Indigenomics Institute</strong><span>Past work as CTO at the intersection of technology, sovereignty and Indigenous economic futures.</span></a></li>\n            <li><a href=\"https://ethosblockparty.com/the-day\"><strong>Ethos Lab Block Party</strong><span>Eleven songs from conversations in one afternoon, made with consent.</span></a></li>\n            <li><a href=\"/photography/\"><strong>Photography archive</strong><span>Two decades of people, movements, music and expeditions.</span></a></li>\n          </ul>\n        </div>\n        <div>\n          <h3>Creative AI Human Lab</h3>\n          <ul class=\"work-projects\">\n            <li><a href=\"https://www.bothhandsfull.com/\"><strong>Both Hands Full</strong><span>A keynote portal about staying human as the tools get faster.</span></a></li>\n            <li><a href=\"https://www.bothhandsfull.com/album/too-weird-to-die\"><strong>Too Weird to Die</strong><span>A concept album about consent, defiance and survival.</span></a></li>\n            <li><a href=\"https://www.punkrockai.com/\"><strong>Punk Rock AI</strong><span>Writing, talks and experiments for people who like their tools with a little friction.</span></a></li>\n            <li><a href=\"https://skywhaleairways.com/\"><strong>Skywhale Airways</strong><span>A short film and an airport for time travelers, made with Suzy Easton.</span></a></li>\n            <li><a href=\"https://gorgeousghost.com/\"><strong>Gorgeous Ghost</strong><span>A film, song and Signal Atlas from Planet Andromeda.</span></a></li>\n            <li><a href=\"https://wedges.dev/\"><strong>Wedges</strong><span>A remote MCP server that gives agents your taste before they touch your work.</span></a></li>\n            <li><a href=\"https://ghost.radio.fm/\"><strong>Ghost Radio</strong><span>A broadcast for the haunted, song-shaped side of the lab.</span></a></li>\n            <li><a href=\"https://darkcrystal.app/\"><strong>Dark Crystal</strong><span>A tool for cutting through slop to one clean sentence.</span></a></li>\n            <li><a href=\"https://unofficial.city/\"><strong>unofficial.city</strong><span>MADE ON, a protest kit collection with its sources and process in view.</span></a></li>\n            <li><a href=\"https://tidepool.ing/\"><strong>TIDEPOOL.ING</strong><span>A Salish Sea pirate radio station from 2075, playing Eleven Days Underwater on repeat.</span></a></li>\n            <li><a href=\"https://littlesupercluster.com/\"><strong>Little Supercluster</strong><span>Hush Now, Little Supercluster: recorded water meets experimental machine music.</span></a></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"work-wrap work-next\" aria-labelledby=\"work-next-title\">\n    <h2 id=\"work-next-title\">What are you building?</h2>\n    <p>Tell me about the people, the room and what you want to make together.</p>\n    <nav class=\"work-paths\" aria-label=\"Explore related work\">\n      <a href=\"/contact/#inquiries\">Talk about a project</a>\n      <a href=\"/generative-ai-services/\">Explore services</a>\n      <a href=\"/speaking/\">See talks and workshops</a>\n      <a href=\"/photography/\">Explore the photo archive</a>\n    </nav>\n  </section>\n</div>\n\n",
