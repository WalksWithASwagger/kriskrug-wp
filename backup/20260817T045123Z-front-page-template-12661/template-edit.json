  "content": {
    "raw": "<!-- wp:template-part {\"slug\":\"header\",\"area\":\"header\",\"theme\":\"kk-aurora\"} /-->\n\n<!-- wp:group {\"tagName\":\"main\",\"className\":\"aurora-home-2026 aurora-home-revive aurora-keynote-first\",\"layout\":{\"type\":\"default\"}} -->\n<main id=\"aurora-main\" class=\"wp-block-group aurora-home-2026 aurora-home-revive aurora-keynote-first\">\n\n  <!-- wp:html -->\n  <section class=\"aurora-hero-2026\" aria-labelledby=\"aurora-home-title\">\n    <figure class=\"aurora-hero-media\" aria-label=\"Portrait of Kris Krüg\">\n      <img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2023/07/krug-1.jpg?w=2000&amp;ssl=1\"\n        srcset=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2023/07/krug-1.jpg?w=640&amp;ssl=1 640w, https://i0.wp.com/kriskrug.co/wp-content/uploads/2023/07/krug-1.jpg?w=960&amp;ssl=1 960w, https://i0.wp.com/kriskrug.co/wp-content/uploads/2023/07/krug-1.jpg?w=1280&amp;ssl=1 1280w, https://i0.wp.com/kriskrug.co/wp-content/uploads/2023/07/krug-1.jpg?w=1600&amp;ssl=1 1600w, https://i0.wp.com/kriskrug.co/wp-content/uploads/2023/07/krug-1.jpg?w=2000&amp;ssl=1 2000w\"\n        sizes=\"100vw\"\n        alt=\"Portrait of Kris Krüg\"\n        width=\"2000\"\n        height=\"1827\"\n        fetchpriority=\"high\"\n        decoding=\"async\"/>\n    </figure>\n    <div class=\"aurora-hero-scrim\" aria-hidden=\"true\"></div>\n    <div class=\"aurora-hero-copy\" data-reveal>\n      <p class=\"aurora-kicker\">AI keynote speaker · Creative technologist · Community builder</p>\n      <h1 id=\"aurora-home-title\">The model is the <span class=\"aurora-rainbow-word\">message</span>.</h1>\n      <p class=\"aurora-hero-dek\">Kris Krug builds public-interest trust infrastructure for the age of generative intelligence — on stage, inside BC + AI, and at Futureproof Festival.</p>\n      <div class=\"aurora-action-row\">\n        <a class=\"aurora-button aurora-button-primary\" href=\"/services/\">Work with me</a>\n        <a class=\"aurora-button aurora-button-secondary\" href=\"/work/\">Current work ?</a>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"aurora-proof-strip\" id=\"stages\" aria-labelledby=\"aurora-stages-label\" data-reveal>\n    <div class=\"aurora-proof-strip-inner\">\n      <p class=\"aurora-kicker\" id=\"aurora-stages-label\">Recent stages</p>\n      <div class=\"aurora-proof-outlets\" aria-label=\"Stage and outlet names\">\n        <span>TED</span>\n        <span>SXSW</span>\n        <span>Adobe MAX</span>\n        <span>Web Summit</span>\n        <span>FITC</span>\n        <span>MIT Media Lab</span>\n        <span>CreativeMornings</span>\n        <span>UN</span>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"aurora-archive-band\" id=\"archive\" aria-labelledby=\"aurora-archive-title\" data-reveal>\n    <div class=\"aurora-section-head\">\n      <div>\n        <p class=\"aurora-kicker\">Working archive</p>\n        <h2 id=\"aurora-archive-title\">From the contact sheet.</h2>\n      </div>\n      <a href=\"/photography/\">Photography ?</a>\n    </div>\n    <div class=\"aurora-contact-sheet\">\n      <a href=\"/photography/\"><img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/05/kk-laSalle-both-hands-full-25-scaled.jpg?w=720&amp;ssl=1\" alt=\"Kris Krug on stage at LaSalle College Vancouver\" width=\"720\" height=\"720\" loading=\"lazy\" decoding=\"async\"/></a>\n      <a href=\"/photography/\"><img src=\"https://i0.wp.com/www.punkrockai.com/public/photos/michelle-diamond/195.webp?w=720&amp;ssl=1\" alt=\"Kris Krug speaking at CreativeMornings Vancouver\" width=\"720\" height=\"720\" loading=\"lazy\" decoding=\"async\"/></a>\n      <a href=\"/photography/\"><img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/07/kris-krug-creativemornings-portrait-staircase-2026-scaled.jpg?w=720&amp;ssl=1\" alt=\"Kris Krug beside the Vancouver Art Gallery staircase\" width=\"720\" height=\"720\" loading=\"lazy\" decoding=\"async\"/></a>\n      <a href=\"/photography/\"><img src=\"/wp-content/themes/kk-aurora/assets/img/vancouver-ai-meetup-30-kris-community.jpg\" alt=\"Kris Krüg raises one hand onstage while rows of attendees raise their hands at the H.R. MacMillan Space Centre\" width=\"1600\" height=\"1066\" loading=\"lazy\" decoding=\"async\"/></a>\n      <a href=\"/photography/\"><img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/07/kris-krug-vancouver-magazine-power-50-2026.jpg?w=720&amp;ssl=1\" alt=\"Kris Krug with Vancouver Magazine Power 50 award\" width=\"720\" height=\"720\" loading=\"lazy\" decoding=\"async\"/></a>\n      <a href=\"/photography/\"><img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/07/kris-krug-van-ai-portrait-2025.jpg?w=720&amp;ssl=1\" alt=\"Kris Krug in a VAN-AI shirt\" width=\"720\" height=\"720\" loading=\"lazy\" decoding=\"async\"/></a>\n      <a href=\"/photography/\"><img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2023/07/20067931301_e7a16b6f2c_k-1.jpg?w=720&amp;ssl=1\" alt=\"Archive photograph from Kris Krug photography practice\" width=\"720\" height=\"720\" loading=\"lazy\" decoding=\"async\"/></a>\n      <a href=\"/photography/\"><img src=\"https://i0.wp.com/kriskrug.co/wp-content/uploads/2026/07/kris-krug-creativemornings-portrait-close-2026-scaled.jpg?w=720&amp;ssl=1\" alt=\"Portrait of Kris Krug at CreativeMornings Vancouver\" width=\"720\" height=\"720\" loading=\"lazy\" decoding=\"async\"/></a>\n    </div>\n  </section>\n\n  <section class=\"aurora-work-band\" id=\"work\" aria-labelledby=\"aurora-work-title\" data-reveal>\n    <div class=\"aurora-section-head\">\n      <div>\n        <p class=\"aurora-kicker\">Current work</p>\n        <h2 id=\"aurora-work-title\">What Kris is <span class=\"accent\">building now</span>.</h2>\n      </div>\n      <a href=\"/work/\">Full index ?</a>\n    </div>\n    <div class=\"aurora-work-triptych\">\n      <a class=\"aurora-work-card\" href=\"https://bc-ai.ca/\">\n        <div class=\"aurora-work-card-media\">\n          <img src=\"https://i0.wp.com/bc-ai.ca/wp-content/uploads/2026/05/bcai-living-ecosystem.webp?w=900&amp;ssl=1\" alt=\"BC + AI community ecosystem graphic\" width=\"900\" height=\"1200\" loading=\"lazy\" decoding=\"async\"/>\n          <span class=\"aurora-work-card-num\">01</span>\n          <div class=\"aurora-work-card-body\">\n            <p class=\"aurora-kicker\">Community</p>\n            <h3>BC + AI</h3>\n            <p>Province-wide trust layer for responsible AI: meetups, certification, policy rooms, and practical adoption.</p>\n          </div>\n        </div>\n      </a>\n      <a class=\"aurora-work-card\" href=\"https://www.futureproof.website/\">\n        <div class=\"aurora-work-card-media\">\n          <img src=\"https://www.futureproof.website/media/launch/futureproof-salmon-starfield-share-20260527.jpg\" alt=\"Futureproof Festival 2026 key art\" width=\"900\" height=\"1200\" loading=\"lazy\" decoding=\"async\"/>\n          <span class=\"aurora-work-card-num\">02</span>\n          <div class=\"aurora-work-card-body\">\n            <p class=\"aurora-kicker\">Festival</p>\n            <h3>Futureproof</h3>\n            <p>Pacific Northwest gathering where frontier tech, creative practice, and civic trust share one public room.</p>\n          </div>\n        </div>\n      </a>\n      <a class=\"aurora-work-card\" href=\"/speaking/\">\n        <div class=\"aurora-work-card-media\">\n          <img src=\"https://i0.wp.com/www.punkrockai.com/public/photos/michelle-diamond/195.webp?w=900&amp;ssl=1\" alt=\"Kris Krug speaking at CreativeMornings Vancouver\" width=\"900\" height=\"1200\" loading=\"lazy\" decoding=\"async\"/>\n          <span class=\"aurora-work-card-num\">03</span>\n          <div class=\"aurora-work-card-body\">\n            <p class=\"aurora-kicker\">Tour</p>\n            <h3>Keynotes 2026</h3>\n            <p>Stage sessions on taste, human agency, and the operating conditions for responsible AI.</p>\n          </div>\n        </div>\n      </a>\n    </div>\n  </section>\n\n  <section class=\"aurora-services-band\" id=\"services\" aria-labelledby=\"aurora-services-title\" data-reveal>\n    <div class=\"aurora-services-band-inner aurora-feature-band-contrast\">\n      <div class=\"aurora-section-head aurora-section-heading\">\n        <div>\n          <p class=\"aurora-kicker\">Services</p>\n          <h2 id=\"aurora-services-title\">Strategic intervention.</h2>\n        </div>\n        <p class=\"aurora-section-lede\">Three ways to work together — from a single keynote to ongoing advisory. Scoped in writing. No bait-and-switch.</p>\n      </div>\n      <div class=\"aurora-services-grid\">\n        <article class=\"aurora-service-card\" style=\"--service-ribbon:linear-gradient(180deg,#d94a1f 0 20%,#e8b53a 20% 40%,#1f8a86 40% 60%,#2b57a6 60% 80%,#d6337a 80% 100%)\">\n          <p class=\"aurora-kicker\">I.</p>\n          <h3>Keynote</h3>\n          <p>Plain-English stage sessions on AI, taste, and human agency. Custom-scoped for creative, civic, and executive rooms.</p>\n          <p class=\"aurora-service-meta\">Stages · Festivals · Internal summits</p>\n          <a href=\"/services/\">Work with me ?</a>\n        </article>\n        <article class=\"aurora-service-card\" style=\"--service-ribbon:linear-gradient(180deg,#1f8a86 0 25%,#39a8d8 25% 50%,#6b3a97 50% 75%,#171310 75% 100%)\">\n          <p class=\"aurora-kicker\">II.</p>\n          <h3>Workshop</h3>\n          <p>Hands-on sessions for creative teams and leadership offsites. Everyone leaves having built something they can use Monday.</p>\n          <p class=\"aurora-service-meta\">Half-day · Two-day · Remote or in person</p>\n          <a href=\"/services/\">Work with me ?</a>\n        </article>\n        <article class=\"aurora-service-card\" style=\"--service-ribbon:linear-gradient(180deg,#e8b53a 0 20%,#171310 20% 40%,#d94a1f 40% 60%,#171310 60% 80%,#b8862e 80% 100%)\">\n          <p class=\"aurora-kicker\">III.</p>\n          <h3>Ecosystem</h3>\n          <p>Community infrastructure, sponsorship strategy, and public rooms where BC’s AI practice actually meets.</p>\n          <p class=\"aurora-service-meta\">Retainers · Partnerships · Limited seats</p>\n          <a href=\"/services/\">Work with me ?</a>\n        </article>\n      </div>\n    </div>\n  </section>\n  <!-- /wp:html -->\n\n  <!-- wp:group {\"className\":\"aurora-writing-band\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1200px\"}} -->\n  <div class=\"wp-block-group aurora-writing-band\" id=\"writing\">\n    <!-- wp:heading {\"level\":2,\"className\":\"aurora-writing-title\"} -->\n    <h2 class=\"wp-block-heading aurora-writing-title\">Writing</h2>\n    <!-- /wp:heading -->\n\n    <!-- wp:paragraph {\"className\":\"aurora-writing-dek\"} -->\n    <p class=\"aurora-writing-dek\">Essays from the edge of AI, creativity, community, tools, taste, and what happens after the demo.</p>\n    <!-- /wp:paragraph -->\n\n    <!-- wp:query {\"queryId\":2,\"query\":{\"perPage\":3,\"pages\":0,\"offset\":0,\"postType\":\"post\",\"order\":\"desc\",\"orderBy\":\"date\",\"author\":\"\",\"search\":\"\",\"exclude\":[],\"sticky\":\"exclude\",\"inherit\":false},\"className\":\"aurora-writing-query\"} -->\n    <div class=\"wp-block-query aurora-writing-query\">\n      <!-- wp:post-template {\"className\":\"aurora-article-list\",\"layout\":{\"type\":\"default\"}} -->\n        <!-- wp:group {\"className\":\"aurora-article-row\",\"layout\":{\"type\":\"constrained\"}} -->\n        <div class=\"wp-block-group aurora-article-row\">\n          <!-- wp:post-terms {\"term\":\"category\",\"className\":\"aurora-article-category\"} /-->\n          <!-- wp:post-title {\"level\":3,\"isLink\":true,\"className\":\"aurora-article-title\"} /-->\n          <!-- wp:post-excerpt {\"excerptLength\":24,\"className\":\"aurora-article-excerpt\"} /-->\n          <!-- wp:post-date {\"className\":\"aurora-article-date\"} /-->\n        </div>\n        <!-- /wp:group -->\n      <!-- /wp:post-template -->\n    </div>\n    <!-- /wp:query -->\n\n    <!-- wp:buttons {\"className\":\"aurora-writing-actions\",\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n    <div class=\"wp-block-buttons aurora-writing-actions\">\n      <!-- wp:button {\"className\":\"is-style-aurora-ghost\"} -->\n      <div class=\"wp-block-button is-style-aurora-ghost\"><a class=\"wp-block-button__link wp-element-button\" href=\"/blog/\">Read the writing</a></div>\n      <!-- /wp:button -->\n    </div>\n    <!-- /wp:buttons -->\n  </div>\n  <!-- /wp:group -->\n\n  <!-- wp:group {\"tagName\":\"section\",\"anchor\":\"newsletter\",\"className\":\"aurora-newsletter-band\",\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1200px\"},\"ariaLabel\":\"Weekly email\"} -->\n  <section id=\"newsletter\" class=\"wp-block-group aurora-newsletter-band\">\n    <!-- wp:html -->\n    <div class=\"aurora-newsletter-copy\" data-reveal>\n      <p class=\"aurora-kicker\">Weekly email</p>\n      <h2 id=\"aurora-newsletter-title\">Give me your email. I’ll earn every open.</h2>\n      <p>Once a week on AI, creativity, and the rooms where this work actually happens. Named people. Real receipts. No hype deck. Free.</p>\n      <div class=\"aurora-action-row\">\n        <a class=\"aurora-button aurora-button-primary\" href=\"https://kriskrug.beehiiv.com/\">Get the weekly email</a>\n      </div>\n    </div>\n    <!-- /wp:html -->\n\n    <!-- wp:heading {\"level\":3,\"className\":\"aurora-newsletter-thumbs-label\"} -->\n    <h3 class=\"wp-block-heading aurora-newsletter-thumbs-label\">Recent writing</h3>\n    <!-- /wp:heading -->\n\n    <!-- wp:query {\"queryId\":16,\"query\":{\"perPage\":3,\"pages\":0,\"offset\":0,\"postType\":\"post\",\"order\":\"desc\",\"orderBy\":\"date\",\"author\":\"\",\"search\":\"\",\"exclude\":[],\"sticky\":\"exclude\",\"inherit\":false},\"className\":\"aurora-newsletter-thumbs-query\"} -->\n    <div class=\"wp-block-query aurora-newsletter-thumbs-query\">\n      <!-- wp:post-template {\"className\":\"aurora-newsletter-thumb-list\",\"layout\":{\"type\":\"grid\",\"columnCount\":3}} -->\n        <!-- wp:group {\"tagName\":\"article\",\"className\":\"aurora-newsletter-thumb\",\"layout\":{\"type\":\"default\"}} -->\n        <article class=\"wp-block-group aurora-newsletter-thumb\">\n          <!-- wp:post-featured-image {\"isLink\":true,\"aspectRatio\":\"3/2\",\"className\":\"aurora-newsletter-thumb-media\"} /-->\n          <!-- wp:post-title {\"level\":4,\"isLink\":true,\"className\":\"aurora-newsletter-thumb-title\"} /-->\n        </article>\n        <!-- /wp:group -->\n      <!-- /wp:post-template -->\n    </div>\n    <!-- /wp:query -->\n  </section>\n  <!-- /wp:group -->\n\n</main>\n<!-- /wp:group -->\n\n<!-- wp:template-part {\"slug\":\"footer\",\"area\":\"footer\",\"theme\":\"kk-aurora\"} /-->\n",
