# Connector-local names for a --path load from this directory.
# The repo contract is ../../.env.schema — extend that file, do not fork it.
# Local values live in ~/.agents/env/values/.env.kriskrug-wp.local and are
# imported by path here so this directory still works after the .env symlink
# is removed. Shared names stay pick-restricted.
# @import(~/.agents/env/values/.env.shared.local, pick=[WP_USER, WP_APP_PASSWORD, NOTION_TOKEN], allowMissing=true)
# @import(~/.agents/env/values/.env.kriskrug-wp.local, allowMissing=true)
# @defaultRequired=false @defaultSensitive=false
# ---

# @optional @example="https://kriskrug.co"
WP_BASE_URL=https://kriskrug.co

# @sensitive
WP_USER=

# @sensitive
WP_APP_PASSWORD=

# Aliases used by ~/.agents/env/wordpress. Optional here; process env from
# the root schema also maps these onto WP_USER / WP_APP_PASSWORD.
# @sensitive @optional
WP_API_USERNAME=
# @sensitive @optional
WP_API_PASSWORD=

# @optional @example="login"
WP_AUTH_MODE=

# @optional @example="1"
WP_DEFAULT_AUTHOR_ID=1

# @sensitive @optional
NOTION_TOKEN=
