# Names-only example. Local values live in
# ~/.agents/env/values/.env.kriskrug-wp.local and are imported by path from
# the repo-root .env.schema. Documented connector commands load them through
# `varlock run --inject vars` (or `make varlock-run`). Do not copy secrets
# into this repo.
#
# Agent-readable contract: see ../../.env.schema (Varlock).
# See docs/current-state/VARLOCK-ROLLOUT-2026-07-16.md
#
# This file is a leftover compatibility template for a gitignored
# scripts/notion-to-wp/.env cache. Prefer process env from Varlock.
# Copy to .env only when a tool cannot read process env. Use placeholders
# here. Never commit real values.

# 1. NOTION_TOKEN — optional if you only run WP-side scripts.
#    Sibling-path fallback (KKAI_ENV_PATH / ~/Code/notion-local/...) is DEPRECATED
#    as secret SoT; still works for compat if the file exists.
# NOTION_TOKEN=your-notion-integration-token

# 2. WordPress credentials for kriskrug.co
#    Generate at: https://kriskrug.co/wp-admin/profile.php
#    → scroll to "Application Passwords"
#    → name "kk-notion-to-wp" → Add New Application Password
#    → copy the generated password (it's only shown once)
WP_USER=your-wp-username
WP_APP_PASSWORD=your-wordpress-application-password

# 3. Optional overrides
# WP_BASE_URL=https://kriskrug.co
# WP_AUTH_MODE=basic
# Use WP_AUTH_MODE=login only when an ordinary wp-admin password is required for
# a nonce-gated REST path. Keep the password in the gitignored values file only.
# WP_DEFAULT_AUTHOR_ID=1
# WP_AUTH_MODE=login
# KKAI_ENV_PATH=/path/to/sibling/.env
# KKAI_CONTENT_ROOT=/path/to/kk-ai-ecosystem
